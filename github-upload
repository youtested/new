#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/github-upload"
ACCOUNT="default"
REPO=""
BRANCH=""
MESSAGE=""
REMOTE_PATH=""
CREATE_REPO=false
PRIVATE_REPO=false
DESCRIPTION=""
DRY_RUN=false
QUIET=false
LIST_PATH=""
DELETE_PATH=""
ACTION="upload"
FILES=()

log(){ $QUIET || printf '%s\n' "$*"; }
err(){ printf 'Error: %s\n' "$*" >&2; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || err "Missing dependency: $1"; }
usage(){ cat <<USAGE
GitHub Direct Upload Tool v$VERSION

Usage:
  github-upload -r owner/repo [options] FILE...
  github-upload -A|--add-account [ACCOUNT]
  github-upload --list-repos
  github-upload -r owner/repo --list [PATH]
  github-upload -r owner/repo --delete PATH

Options:
  -r, --repo REPO             Repository as repo or owner/repo
  -c, --create                Create repository when missing
  -p, --private               Create repository as private
  -d, --description TEXT      Repository description when creating
  -m, --message TEXT          Commit message
  -f, --file-path PATH        Upload path for a single file
  -B, --branch NAME           Target branch
  -A, --add-account [NAME]    Save GitHub credentials
  -a, --account NAME          Use saved account
      --list-accounts         Show saved accounts
      --list [PATH]           List repository contents
      --list-repos            List repositories for the token
      --delete PATH           Delete a repository file
  -n, --dry-run               Preview actions without changing GitHub
  -q, --quiet                 Minimal output
      --clear                 Remove saved credentials
  -h, --help                  Show this help
USAGE
}

urlenc(){ jq -rn --arg v "$1" '$v|@uri'; }
account_file(){ if [[ "$ACCOUNT" == default ]]; then printf '%s/config' "$CONFIG_DIR"; else printf '%s/accounts/%s/config' "$CONFIG_DIR" "$ACCOUNT"; fi; }
load_config(){
  [[ -n "${GITHUB_TOKEN:-}" ]] && TOKEN="$GITHUB_TOKEN" || TOKEN=""
  [[ -n "${GITHUB_USERNAME:-}" ]] && USERNAME="$GITHUB_USERNAME" || USERNAME=""
  local file; file="$(account_file)"
  if [[ -f "$file" ]]; then # shellcheck disable=SC1090
    source "$file"
    TOKEN="${GITHUB_TOKEN:-${TOKEN:-}}"; USERNAME="${GITHUB_USERNAME:-${USERNAME:-}}"
  fi
  [[ -n "${TOKEN:-}" ]] || err "No GitHub token configured. Run: github-upload -A"
}
api(){
  local method="$1" path="$2" data="${3:-}"
  local tmp code
  tmp="$(mktemp)"
  if [[ -n "$data" ]]; then
    code=$(curl -sS -o "$tmp" -w '%{http_code}' -X "$method" -H "Authorization: Bearer $TOKEN" -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' --data "$data" "https://api.github.com$path")
  else
    code=$(curl -sS -o "$tmp" -w '%{http_code}' -X "$method" -H "Authorization: Bearer $TOKEN" -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' "https://api.github.com$path")
  fi
  if [[ "$code" =~ ^2 ]]; then cat "$tmp"; rm -f "$tmp"; else cat "$tmp" >&2; rm -f "$tmp"; err "GitHub API $method $path failed with HTTP $code"; fi
}
normalize_repo(){
  [[ -n "$REPO" ]] || err "Repository is required (-r owner/repo)"
  if [[ "$REPO" != */* ]]; then
    [[ -n "${USERNAME:-}" ]] || USERNAME="$(api GET /user | jq -r '.login')"
    REPO="$USERNAME/$REPO"
  fi
  OWNER="${REPO%%/*}"; NAME="${REPO#*/}"
}
add_account(){
  need jq; mkdir -p "$CONFIG_DIR/accounts"
  local name="${1:-$ACCOUNT}" file token user
  [[ "$name" == default ]] && file="$CONFIG_DIR/config" || { mkdir -p "$CONFIG_DIR/accounts/$name"; file="$CONFIG_DIR/accounts/$name/config"; }
  read -r -p "GitHub username: " user
  read -r -s -p "GitHub token: " token; printf '\n'
  [[ -n "$user" && -n "$token" ]] || err "Username and token are required"
  umask 077; printf 'GITHUB_USERNAME=%q\nGITHUB_TOKEN=%q\n' "$user" "$token" > "$file"; chmod 600 "$file"
  log "Saved account '$name' to $file"
}
create_repo_if_needed(){
  if $DRY_RUN; then log "DRY RUN verify repository $REPO"; return; fi
  if api GET "/repos/$OWNER/$NAME" >/dev/null 2>&1; then return; fi
  $CREATE_REPO || err "Repository $REPO not found. Use --create to create it."
  local private="false"; $PRIVATE_REPO && private="true"
  api POST /user/repos "$(jq -cn --arg name "$NAME" --arg desc "$DESCRIPTION" --argjson private "$private" '{name:$name,description:$desc,private:$private}')"
}
repo_path_for(){
  local file="$1"
  if [[ -n "$REMOTE_PATH" ]]; then printf '%s' "$REMOTE_PATH"; else basename "$file"; fi
}
upload_one(){
  local file="$1" path sha payload content msg
  [[ -f "$file" ]] || err "File not found: $file"
  path="$(repo_path_for "$file")"
  msg="${MESSAGE:-Upload $path}"
  if $DRY_RUN; then log "DRY RUN upload $file -> $REPO:$path"; return; fi
  content="$(base64 < "$file" | tr -d '\n')"
  sha="$(api GET "/repos/$OWNER/$NAME/contents/$(urlenc "$path")?ref=${BRANCH:-$(urlenc main)}" 2>/dev/null | jq -r '.sha // empty' || true)"
  if [[ -n "$sha" ]]; then
    payload="$(jq -cn --arg message "$msg" --arg content "$content" --arg sha "$sha" --arg branch "$BRANCH" '{message:$message,content:$content,sha:$sha} + (if $branch != "" then {branch:$branch} else {} end)')"
  else
    payload="$(jq -cn --arg message "$msg" --arg content "$content" --arg branch "$BRANCH" '{message:$message,content:$content} + (if $branch != "" then {branch:$branch} else {} end)')"
  fi
  api PUT "/repos/$OWNER/$NAME/contents/$(urlenc "$path")" "$payload" >/dev/null
  log "Uploaded $file -> $REPO:$path"
}
list_contents(){
  local path="${LIST_PATH:-}"
  api GET "/repos/$OWNER/$NAME/contents/$(urlenc "$path")" | jq -r 'if type=="array" then .[] | [.type,.path,(.size|tostring)]|@tsv else [.type,.path,(.size|tostring)]|@tsv end'
}
delete_file(){
  [[ -n "$DELETE_PATH" ]] || err "Delete path is required"
  local sha msg payload
  msg="${MESSAGE:-Delete $DELETE_PATH}"
  if $DRY_RUN; then log "DRY RUN delete $REPO:$DELETE_PATH"; return; fi
  sha="$(api GET "/repos/$OWNER/$NAME/contents/$(urlenc "$DELETE_PATH")" | jq -r '.sha')"
  payload="$(jq -cn --arg message "$msg" --arg sha "$sha" --arg branch "$BRANCH" '{message:$message,sha:$sha} + (if $branch != "" then {branch:$branch} else {} end)')"
  api DELETE "/repos/$OWNER/$NAME/contents/$(urlenc "$DELETE_PATH")" "$payload" >/dev/null
  log "Deleted $REPO:$DELETE_PATH"
}
list_repos(){ api GET '/user/repos?per_page=100&sort=updated' | jq -r '.[] | [.full_name,.private,.updated_at]|@tsv'; }
list_accounts(){
  [[ -f "$CONFIG_DIR/config" ]] && echo default
  [[ -d "$CONFIG_DIR/accounts" ]] && find "$CONFIG_DIR/accounts" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null || true
}

while (($#)); do
  case "$1" in
    -r|--repo) REPO="${2:-}"; shift 2;;
    -c|--create) CREATE_REPO=true; shift;;
    -p|--private) PRIVATE_REPO=true; shift;;
    -d|--description) DESCRIPTION="${2:-}"; shift 2;;
    -m|--message) MESSAGE="${2:-}"; shift 2;;
    -f|--file-path) REMOTE_PATH="${2:-}"; shift 2;;
    -B|--branch|--source-branch) BRANCH="${2:-}"; shift 2;;
    -A|--add-account) ACTION="add-account"; if [[ "${2:-}" != "" && "${2:0:1}" != "-" ]]; then ACCOUNT="$2"; shift 2; else shift; fi;;
    -a|--account) ACCOUNT="${2:-}"; shift 2;;
    --list-accounts) ACTION="list-accounts"; shift;;
    --list-repos) ACTION="list-repos"; shift;;
    --list) ACTION="list"; if [[ "${2:-}" != "" && "${2:0:1}" != "-" ]]; then LIST_PATH="$2"; shift 2; else shift; fi;;
    --delete) ACTION="delete"; DELETE_PATH="${2:-}"; shift 2;;
    -n|--dry-run) DRY_RUN=true; shift;;
    -q|--quiet) QUIET=true; shift;;
    --clear) rm -rf "$CONFIG_DIR"; echo "Cleared $CONFIG_DIR"; exit 0;;
    -h|--help) usage; exit 0;;
    --version) echo "$VERSION"; exit 0;;
    --) shift; FILES+=("$@"); break;;
    -*) err "Unknown option: $1";;
    *) FILES+=("$1"); shift;;
  esac
done

need curl; need jq; need base64
case "$ACTION" in
  add-account) add_account "$ACCOUNT";;
  list-accounts) list_accounts;;
  list-repos) load_config; list_repos;;
  list) load_config; normalize_repo; list_contents;;
  delete) load_config; normalize_repo; delete_file;;
  upload)
    ((${#FILES[@]})) || { usage; err "No files provided"; }
    [[ -n "$REMOTE_PATH" && ${#FILES[@]} -gt 1 ]] && err "--file-path can only be used with one file"
    load_config; normalize_repo; create_repo_if_needed
    for file in "${FILES[@]}"; do upload_one "$file"; done
    ;;
esac
